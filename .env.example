# Public site URL (used for metadata & sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL connection strings (Neon / Supabase / local)
# DATABASE_URL is used by the app at runtime. On Supabase use the Transaction pooler (port 6543) with ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL is used by Prisma migrations. On Supabase use the Session pooler (port 5432). For a plain Postgres, use the same value as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Auth.js secret — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Single admin credentials
ADMIN_EMAIL="you@example.com"
# Base64-encoded bcrypt hash — generate with: npm run hash-password -- "your-password"
ADMIN_PASSWORD_HASH=""

# Cloudflare R2 (image uploads)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public bucket URL (r2.dev subdomain or custom domain), no trailing slash
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
