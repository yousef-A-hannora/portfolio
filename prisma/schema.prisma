generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ThumbnailType {
  IMAGE
  VIDEO
}

model Project {
  id               String          @id @default(cuid())
  slug             String          @unique
  title            String
  category         String
  shortDescription String
  description      String          @db.Text
  thumbnailType    ThumbnailType   @default(IMAGE)
  thumbnailImage   String?
  youtubeUrl       String?
  liveUrl          String?
  repoUrl          String?
  techStack        String[]
  featured         Boolean         @default(false)
  published        Boolean         @default(true)
  order            Int             @default(0)
  images           ProjectImage[]
  metrics          ProjectMetric[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([published, featured, order])
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  order     Int     @default(0)

  @@index([projectId])
}

model ProjectMetric {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  value     Int
  prefix    String  @default("")
  suffix    String  @default("")
  label     String
  icon      String
  order     Int     @default(0)

  @@index([projectId])
}

model Skill {
  id    String @id @default(cuid())
  name  String
  icon  String
  order Int    @default(0)
}

model Service {
  id          String @id @default(cuid())
  title       String
  description String
  icon        String
  order       Int    @default(0)
}

model Experience {
  id          String @id @default(cuid())
  role        String
  company     String
  period      String
  description String
  order       Int    @default(0)
}

model SiteMetric {
  id     String @id @default(cuid())
  key    String @unique
  value  Int
  prefix String @default("")
  suffix String @default("")
  label  String
  icon   String
  order  Int    @default(0)
}
